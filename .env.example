# Variables de entorno — ClimaTech HVAC
# Copiar este archivo como .env.local y completar los valores

# ─── Base de Datos (Render PostgreSQL) ──────────────────────────────────────
# Obtener desde: render.com → tu proyecto PostgreSQL → "Connection" → "External Database URL"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-secret-generado"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google Tag Manager (opcional) ───────────────────────────────────────────
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
